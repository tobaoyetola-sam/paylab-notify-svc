{
  "family": "paylab-notify-svc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/paylabTaskRole",
  "containerDefinitions": [
    {
      "name": "notify-svc",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/paylab/notify-svc:v1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8083,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "8083"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/paylab",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "notify-svc"
        }
      }
    }
  ]
}
